{
	"cli": {
		"version": ">= 16.28.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "store",
			"channel": "preview",
			"environment": "production",
			"android": {
				"buildType": "apk"
			},
			"ios": {
				"simulator": false,
				"autoIncrement": "buildNumber"
			}
		},
		"production": {
			"distribution": "store",
			"channel": "production",
			"environment": "production",
			"android": {
				"buildType": "app-bundle"
			},
			"ios": {
				"simulator": false,
				"autoIncrement": "buildNumber"
			}
		}
	},
	"submit": {
		"preview": {},
		"production": {}
	}
}
