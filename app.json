{
	"expo": {
		"name": "OM Mobile",
		"slug": "ommobile-app",
		"owner": "organicministryapp",
		"version": "1.2.2",
		"orientation": "portrait",
		"icon": "./assets/images/app_icon.png",
		"scheme": "ommobileapp",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.anonymous.ommobileapp",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"LSSupportsOpeningDocumentsInPlace": true,
				"UIFileSharingEnabled": true,
				"UIBackgroundModes": [
					"remote-notification",
					"remote-notification"
				]
			},
			"entitlements": {
				"aps-environment": "development",
				"com.apple.security.application-groups": [
					"group.${ios.bundleIdentifier}.onesignal",
					"group.${ios.bundleIdentifier}.onesignal"
				]
			}
		},
		"android": {
			"versionCode": 1202,
			"icon": "./assets/images/app_icon.png",
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.anonymous.ommobileapp",
			"permissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS",
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS"
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/app_icon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash_logo.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundImage": "./assets/images/splash_background.png",
					"backgroundColor": "#000000",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			"expo-font",
			[
				"expo-audio",
				{
					"microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone.",
					"enableBackgroundPlayback": true
				}
			],
			"expo-asset",
			[
				"onesignal-expo-plugin",
				{
					"mode": "development"
				}
			],
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"build": {
					"experimental": {
						"ios": {
							"appExtensions": [
								{
									"targetName": "OneSignalNotificationServiceExtension",
									"bundleIdentifier": "com.anonymous.ommobileapp.OneSignalNotificationServiceExtension",
									"entitlements": {
										"com.apple.security.application-groups": [
											"group.com.anonymous.ommobileapp.onesignal"
										]
									}
								}
							]
						}
					}
				},
				"projectId": "90251ff0-811a-441a-af8f-b27a0f9f463f"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/90251ff0-811a-441a-af8f-b27a0f9f463f"
		}
	}
}
