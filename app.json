{
	"expo": {
		"name": "OM Mobile",
		"slug": "ommobile-app",
		"owner": "organicministryapp",
		"version": "1.4.2",
		"orientation": "default",
		"icon": "./assets/images/app_icon.png",
		"scheme": "ommobileapp",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.anonymous.ommobileapp",
			"buildNumber": "5",
			"associatedDomains": ["applinks:mobile.organic-ministry.org"],
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"LSSupportsOpeningDocumentsInPlace": true,
				"UIFileSharingEnabled": true,
				"UIBackgroundModes": ["remote-notification"]
			},
			"entitlements": {
				"aps-environment": "production",
				"com.apple.security.application-groups": [
					"group.com.anonymous.ommobileapp.onesignal"
				]
			}
		},
		"android": {
			"versionCode": 1402,
			"icon": "./assets/images/app_icon.png",
			"predictiveBackGestureEnabled": false,
			"package": "com.anonymous.ommobileapp",
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [
						{
							"scheme": "https",
							"host": "mobile.organic-ministry.org",
							"pathPrefix": "/teachings"
						},
						{
							"scheme": "https",
							"host": "mobile.organic-ministry.org",
							"pathPrefix": "/notifications"
						},
						{
							"scheme": "https",
							"host": "mobile.organic-ministry.org",
							"pathPrefix": "/auth"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			],
			"blockedPermissions": ["android.permission.RECORD_AUDIO"]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/app_icon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash_logo.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#171F2A",
					"dark": {
						"backgroundColor": "#171F2A"
					}
				}
			],
			"expo-font",
			[
				"expo-audio",
				{
					"microphonePermission": false,
					"recordAudioAndroid": false,
					"enableBackgroundPlayback": true
				}
			],
			"expo-asset",
			[
				"expo-secure-store",
				{
					"faceIDPermission": false
				}
			],
			[
				"onesignal-expo-plugin",
				{
					"mode": "production",
					"iPhoneDeploymentTarget": "15.1"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"build": {
					"experimental": {
						"ios": {
							"appExtensions": [
								{
									"targetName": "OneSignalNotificationServiceExtension",
									"bundleIdentifier": "com.anonymous.ommobileapp.OneSignalNotificationServiceExtension",
									"entitlements": {
										"com.apple.security.application-groups": [
											"group.com.anonymous.ommobileapp.onesignal"
										]
									}
								}
							]
						}
					}
				},
				"projectId": "90251ff0-811a-441a-af8f-b27a0f9f463f"
			}
		},
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/90251ff0-811a-441a-af8f-b27a0f9f463f"
		}
	}
}
